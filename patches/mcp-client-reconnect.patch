+# fork-patch: mcp-reconnect-on-session-invalid
+# 上游只在 anyio.ClosedResourceError 时重连。服务端正常返回“这条会话已失效”
+# （HTTP 404 Session not found / Session terminated）时，SDK 抛的是 McpError，
+# 不属于上面那类异常，于是**不重连**，会话会一直坏到进程重启为止 —— 实测表现为
+# 服务端重启后工具调用持续失败，只能重新保存 MCP 条目。这里把“会话失效”也纳入重连条件。
+# 改动记录见仓库根目录 FORK-NOTES.md。
+_SESSION_INVALID_MARKERS = ("not found", "terminated", "expired", "invalid", "404")
+
+
+def _is_session_invalid(exc: BaseException) -> bool:
+    """该异常是否表示“这条 MCP 会话已不可用，需要重连后重试”。"""
+    if isinstance(exc, (anyio.ClosedResourceError, anyio.BrokenResourceError)):
+        return True
+    text = f"{exc}".lower()
+    if "session" not in text:
+        return False
+    return any(marker in text for marker in _SESSION_INVALID_MARKERS)
+
+
 class MCPClient:
     def __init__(self) -> None:
         self.session: mcp.ClientSession | None = None
